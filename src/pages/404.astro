---
// Página para direcciones que no existen. Misma estética que el inicio.
import Layout from '../layouts/Layout.astro';
import { CONFIG } from '../config';
---

<Layout titulo={`Página no encontrada | ${CONFIG.nombre}`} noIndexar>
  <main class="pagina-404">
    <img src="/img/logo-hero-640.webp" width="1603" height="1047" alt={`${CONFIG.nombre}, Estudio Jurídico`} class="logo-404" />
    <h1>Página no encontrada</h1>
    <a href="/" class="btn">Volver al inicio</a>
  </main>
</Layout>
