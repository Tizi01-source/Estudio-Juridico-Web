---
import { menu } from '../data/textos';
import Icono from './Icono.astro';
---

<!-- Logo (copia recortada, en WebP) -->
<div class="logo-nav" id="logo-btn">
  <img src="/img/logo-nav-128.webp" srcset="/img/logo-nav-64.webp 64w, /img/logo-nav-128.webp 128w" sizes="49px" width="126" height="107" alt="Costantini y Asociados, ir al inicio" />
</div>

<!-- Menú de Navegación -->
<nav id="navbar">
  <button type="button" id="btn-cerrar" aria-label="Cerrar menú"><Icono nombre="cerrar" /></button>
  {menu.map((item) => <a href={item.ancla} class="nav-link">{item.texto}</a>)}
</nav>

<script>
  const navbar = document.getElementById('navbar')!;
  const logoBtn = document.getElementById('logo-btn')!;
  const esCelular = () => window.innerWidth <= 768;

  // Al tocar la crucecita, el panel se vuelve a esconder
  document.getElementById('btn-cerrar')!.addEventListener('click', () => navbar.classList.remove('abierto'));

  // Al tocar el logo (en celular), abrimos o cerramos el menú
  logoBtn.addEventListener('click', () => {
    if (esCelular()) navbar.classList.toggle('abierto');
  });

  // Al tocar cualquier enlace, cerramos el menú
  document.querySelectorAll('.nav-link').forEach((link) =>
    link.addEventListener('click', () => {
      if (esCelular()) navbar.classList.remove('abierto');
    }),
  );

  // Barra oscura al hacer scroll
  window.addEventListener('scroll', () => navbar.classList.toggle('scrolled', window.scrollY > 50), { passive: true });
</script>
