---
// Layout: el "molde" común de todas las páginas (head, SEO y estructura base).
// Cada página pone su contenido donde está el <slot />.
import { CONFIG } from '../config';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { titulo = CONFIG.tituloPagina, descripcion = CONFIG.descripcion } = Astro.props;
const imagenVistaPrevia = new URL('assets/og-image.jpg', CONFIG.url).href;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={CONFIG.url} />

    <!-- Vista previa al compartir el link (WhatsApp, Facebook, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={CONFIG.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={CONFIG.url} />
    <meta property="og:image" content={imagenVistaPrevia} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo de Costantini y Asociados, Estudio Jurídico" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenVistaPrevia} />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  </head>
  <body>
    <slot />
    <script is:inline src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  </body>
</html>
