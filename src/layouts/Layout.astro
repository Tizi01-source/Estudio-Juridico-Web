---
// Layout: el "molde" común de todas las páginas (head, SEO y estructura base).
// Cada página pone su contenido donde está el <slot />.
import { CONFIG } from '../config';
import DatosEstructurados from '../components/DatosEstructurados.astro';
import Aviso from '../components/Aviso.astro';

// Fuentes autoalojadas: solo el alfabeto latino y los pesos que se usan
import '@fontsource/playfair-display/latin-600.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** true en páginas que Google no debe mostrar (por ejemplo, la 404) */
  noIndexar?: boolean;
}

const { titulo = CONFIG.tituloPagina, descripcion = CONFIG.descripcion, noIndexar = false } = Astro.props;
const imagenVistaPrevia = new URL('assets/og-image.jpg', CONFIG.url).href;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- Marca que hay JavaScript: recién ahí se esconden los bloques que aparecen al hacer scroll -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {noIndexar ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={CONFIG.url} />}
    <meta name="theme-color" content="#111111" />

    <!-- Vista previa al compartir el link (WhatsApp, Facebook, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={CONFIG.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={CONFIG.url} />
    <meta property="og:image" content={imagenVistaPrevia} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo de Costantini y Asociados, Estudio Jurídico" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenVistaPrevia} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

    {!noIndexar && <DatosEstructurados />}
  </head>
  <body>
    <slot />
    <Aviso />

    <script>
      // Animaciones de entrada: cada bloque con data-aparecer se muestra al entrar en pantalla
      const bloques = document.querySelectorAll('[data-aparecer]');
      if ('IntersectionObserver' in window) {
        const observador = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (entrada.isIntersecting) {
                entrada.target.classList.add('visible');
                observador.unobserve(entrada.target);
              }
            });
          },
          { rootMargin: '0px 0px -40px 0px', threshold: 0.1 },
        );
        bloques.forEach((bloque) => observador.observe(bloque));
      } else {
        bloques.forEach((bloque) => bloque.classList.add('visible'));
      }
    </script>
  </body>
</html>
